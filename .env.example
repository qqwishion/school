# Set these as environment variables; this file is a reference, not automatically loaded.
DEBUG=0
DEMO_MODE=0
SECRET_KEY=replace-with-a-long-random-secret
ALLOWED_HOSTS=shag.example.org
CSRF_TRUSTED_ORIGINS=https://shag.example.org
DATABASE_URL=postgresql://shag:replace-password@127.0.0.1:5432/shag
DB_SSLMODE=prefer
# Only with the trusted reverse proxy shown in deploy/nginx.conf.example.
TRUST_PROXY=1
